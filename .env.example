# ---------------------------------------------------------------
# Logseq DB (web + sync) — self-hosted stack
# Copy to .env and fill in real values. In Coolify, set the same
# variables in the UI (Environment Variables tab) — Coolify injects
# them at deploy time, the .env file itself never reaches the server.
# ---------------------------------------------------------------

# Base domain of the deployment. Hostnames are fixed as:
#   sync.logseq.<BASE_DOMAIN>   (sync server, port 8787)
#   web.logseq.<BASE_DOMAIN>    (web app / PWA, port 8080)
BASE_DOMAIN=example.com

# Random admin token for the sync server (openssl rand -hex 32)
DB_SYNC_ADMIN_TOKEN=REPLACE_ME

# --- Storage ---
DB_SYNC_DATA_DIR=/app/data
DB_SYNC_STORAGE_DRIVER=sqlite
DB_SYNC_ASSETS_DRIVER=filesystem

# --- Server ---
DB_SYNC_PORT=8787
DB_SYNC_LOG_LEVEL=info

# --- Logseq account auth (official Cognito pool) ---
# Clients still sign in with a free Logseq account; self-hosting only
# replaces the storage/sync endpoint, not authentication.
# The values are published in the upstream project docs
# (github.com/yshalsager/logseq-selfhost).
COGNITO_ISSUER=REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME
COGNITO_JWKS_URL=REPLACE_ME

# --- Image pins (bump to upgrade) ---
SYNC_IMAGE=ghcr.io/yshalsager/logseq-selfhost-sync:latest
WEB_IMAGE=ghcr.io/yshalsager/logseq-selfhost-web:latest
